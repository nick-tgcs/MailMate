{
  "manifest_version": 3,
  "name": "MailMate",
  "version": "0.1.0",
  "description": "MailMate — local-first learning mail assistant. Phase 11: sales pipeline + review-required follow-up workflows over the native host.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailmate@example.com",
      "strict_min_version": "140.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "menus",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesModify",
    "accountsRead",
    "compose",
    "compose.save"
  ],
  "background": {
    "scripts": [
      "native.js",
      "message_reader.js",
      "drafts.js",
      "followups.js",
      "context_menu.js",
      "background.js"
    ]
  }
}
