{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "0.1.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailmate@example.com",
      "strict_min_version": "140.0"
    }
  },
  "action": {
    "default_title": "MailMate",
    "default_popup": "action.html"
  },
  "message_display_action": {
    "default_title": "MailMate",
    "default_popup": "panel.html"
  },
  "compose_action": {
    "default_title": "MailMate",
    "default_popup": "compose.html"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "permissions": [
    "nativeMessaging",
    "menus",
    "messagesRead",
    "messagesMove",
    "messagesUpdate",
    "messagesModify",
    "accountsRead",
    "addressBooks",
    "compose",
    "compose.save",
    "storage",
    "notifications"
  ],
  "background": {
    "scripts": [
      "native.js",
      "message_reader.js",
      "drafts.js",
      "followups.js",
      "context_menu.js",
      "notifications.js",
      "background.js"
    ]
  }
}
