{
  "manifest_version": 3,
  "name": "MailMate",
  "version": "0.1.0",
  "description": "MailMate — local-first learning mail assistant. Phase 1: native host ping skeleton.",
  "browser_specific_settings": {
    "gecko": {
      "id": "mailmate@example.com",
      "strict_min_version": "140.0"
    }
  },
  "permissions": ["nativeMessaging"],
  "background": {
    "scripts": ["native.js", "background.js"]
  }
}
